# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
# Only this Telegram user ID may use the bot (message @userinfobot to find yours)
TELEGRAM_USER_ID=123456789

# Deye Open API (https://developer.deyecloud.com)
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
# eu | am | india
DEYE_DATA_CENTER=eu
# Optional: inverter serial. If empty the bot picks the first INVERTER on your account.
DEYE_DEVICE_SN=

# Collector / charts
DB_PATH=deye_bot.db
POLL_MINUTES=5
TIMEZONE=Europe/Helsinki
